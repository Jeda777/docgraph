# --- server ---
DB_USER=docgraph
DB_PASSWORD=docgraph
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docgraph
DB_SSL=false # true | false | no-verify (TLS without certificate check)
DB_POOL_MAX=20 # max open connections in the pool
APP_URL=http://localhost:5173
PORT=3000
HOST=localhost
# --- logging (optional) ---
LOG_LEVEL=info # trace | debug | info | warning | error | fatal
LOG_FORMAT=text # text | json (one JSON object per line, for log aggregators)
# --- auth secrets ---
BETTER_AUTH_SECRET=change-me-at-least-32-random-characters # e.g. openssl rand -base64 32
# --- initial admin account (seeded on first start) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Strong-passw0rd
# --- smtp ---
# Optional: remove all SMTP_* vars to log login codes and invitation links instead of emailing them
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=user@example.com
SMTP_PASSWORD=password
SMTP_TLS=false #true for tls; false for starttls
SMTP_FROM=no-reply@example.com
