{
  "name": "docgraph",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm turbo dev",
    "build": "pnpm turbo build",
    "format": "pnpm biome format --write .",
    "lint": "pnpm biome lint",
    "check": "pnpm biome check",
    "test": "pnpm turbo test",
    "test:e2e": "pnpm turbo test:e2e",
    "docker:dev": "docker compose --env-file apps/server/.env -f docker/docker-compose.dev.yml up -d",
    "docker:dev:postgres": "docker compose --env-file apps/server/.env -f docker/docker-compose.dev.yml up -d postgres",
    "docker:dev:mailpit": "docker compose --env-file apps/server/.env -f docker/docker-compose.dev.yml up -d mailpit"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "lefthook": "^2.2.1",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
