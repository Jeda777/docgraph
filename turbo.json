{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "with": ["db:studio", "email:dev"]
    },
    "db:studio": {
      "persistent": true,
      "cache": false
    },
    "email:dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "passThroughEnv": ["CI", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "passThroughEnv": ["CI", "DOCKER_*", "TESTCONTAINERS_*", "PLAYWRIGHT_*"]
    }
  }
}
